@{
    var code = ViewData["Code"] as int? ?? 0;
    ViewData["Title"] = code == 404 ? "Page not found" : "Something went wrong";
}
<div class="empty-state">
    @if (code == 404)
    {
        <h1>That page doesn't exist</h1>
        <p>The event or page you were looking for couldn't be found.</p>
    }
    else
    {
        <h1>Something went wrong</h1>
        <p>Please go back and try again.</p>
    }
    <a class="btn btn-rd" asp-controller="Home" asp-action="Index">Back to events</a>
</div>
