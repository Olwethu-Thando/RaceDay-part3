@model List<ResultResponse>
@{
    ViewData["Title"] = "My results";
}
<div class="page-head"><h1>My results</h1></div>
<partial name="_Alerts" />

@if (!Model.Any())
{
    <div class="empty-state"><h2>No results yet</h2><p>Your race history appears here after an organiser publishes results for an event you entered.</p></div>
}
else
{
    <div class="table-responsive">
        <table class="table rd-table align-middle">
            <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td><a asp-controller="Events" asp-action="Details" asp-route-id="@r.EventId">@r.EventName</a></td>
                    <td>@Format.DateText(r.EventDate)</td>
                    <td>@r.CategoryName</td>
                    <td class="mono">@r.FinishTime</td>
                    <td><strong>@Format.Ordinal(r.FinishPosition)</strong> out of @r.TotalFinishers finishers</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
