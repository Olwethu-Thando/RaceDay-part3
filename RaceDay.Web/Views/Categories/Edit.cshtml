@model CategoryFormModel
@{
    ViewData["Title"] = "Edit category";
}
<div class="page-head">
    <div>
        <h1>Edit category</h1>
        @if (ViewData["EventName"] is string eventName)
        {
            <p class="text-muted mb-0">@eventName</p>
        }
    </div>
</div>
<div class="form-card form-card-narrow">
    <form asp-action="Edit" asp-route-eventId="@Model.EventId" asp-route-id="@Model.CategoryId" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <partial name="_CategoryFields" model="Model" />
        <div class="form-actions">
            <button type="submit" class="btn btn-rd">Save changes</button>
            <a class="btn btn-rd-outline" asp-action="Index" asp-route-eventId="@Model.EventId">Cancel</a>
        </div>
    </form>
</div>
