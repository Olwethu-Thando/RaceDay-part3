@model CategoriesViewModel
@{
    ViewData["Title"] = "Categories";
    var categories = Model.Event.Categories ?? new List<CategoryResponse>();
}
<div class="page-head">
    <div>
        <h1>Categories</h1>
        <p class="text-muted mb-0">@Model.Event.Name &middot; @Format.DateText(Model.Event.EventDate)</p>
    </div>
    <a class="btn btn-rd-outline" asp-controller="ManageEvents" asp-action="Index">Back to events</a>
</div>
<partial name="_Alerts" />

<div class="row g-4">
    <div class="col-lg-7">
        @if (!categories.Any())
        {
            <div class="empty-state small-empty"><p>No categories yet. Add the first one.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table rd-table align-middle">
                    <thead><tr><th>Name</th><th>Ages</th><th>Distance</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var c in categories)
                    {
                        <tr>
                            <td>@c.Name</td>
                            <td>@Format.AgeRange(c.MinAge, c.MaxAge)</td>
                            <td>@(c.DistanceKm.HasValue ? c.DistanceKm.Value.ToString("0.##") + " km" : "-")</td>
                            <td class="text-end action-cell">
                                <a class="btn btn-sm btn-rd-outline" asp-action="Edit" asp-route-eventId="@Model.Event.EventId" asp-route-id="@c.CategoryId">Edit</a>
                                <form asp-action="Delete" asp-route-eventId="@Model.Event.EventId" asp-route-id="@c.CategoryId" method="post" class="d-inline"
                                      onsubmit="return confirm('Remove this category?');">
                                    <button type="submit" class="btn btn-sm btn-danger-soft">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="col-lg-5">
        <div class="form-card">
            <h2 class="section-title mt-0">Add a category</h2>
            <form asp-action="Create" asp-route-eventId="@Model.Event.EventId" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <partial name="_CategoryFields" model="Model.NewCategory" />
                <button type="submit" class="btn btn-rd w-100 mt-3">Add category</button>
            </form>
        </div>
    </div>
</div>
