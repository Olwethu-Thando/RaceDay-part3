@model EventResponse
@{
    var banner = Api.ImageUrl(Model.BannerImageUrl);
    var typeClass = "type-" + Model.EventType.ToLowerInvariant();
}
<article class="event-card">
    <div class="event-card-media @typeClass">
        @if (banner != null)
        {
            <img src="@banner" alt="Banner for @Model.Name" loading="lazy" />
        }
        else
        {
            <span class="event-card-glyph">@Model.EventType.ToUpperInvariant()</span>
        }
        <span class="type-pill @typeClass">@Model.EventType</span>
    </div>
    <div class="event-card-body">
        <h3>@Model.Name</h3>
        <ul class="event-meta">
            <li>@Format.DateTimeText(Model.EventDate)</li>
            <li>@Model.Location</li>
            <li>@Model.DistanceKm.ToString("0.##") km</li>
        </ul>
        <a class="btn btn-rd w-100" asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">View event</a>
    </div>
</article>
