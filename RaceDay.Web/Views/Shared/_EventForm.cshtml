@model EventFormModel
<input type="hidden" asp-for="EventId" />
<input type="hidden" asp-for="CurrentBannerUrl" />

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" maxlength="150" required />
        <span asp-validation-for="Name" class="field-error"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="EventType" class="form-label"></label>
        <select asp-for="EventType" class="form-select">
            <option value="Run">Run</option>
            <option value="Walk">Walk</option>
            <option value="Cycle">Cycle</option>
        </select>
        <span asp-validation-for="EventType" class="field-error"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4" maxlength="2000"></textarea>
        <span asp-validation-for="Description" class="field-error"></span>
    </div>
    <div class="col-md-5">
        <label asp-for="EventDate" class="form-label"></label>
        <input asp-for="EventDate" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" required />
        <span asp-validation-for="EventDate" class="field-error"></span>
    </div>
    <div class="col-md-5">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" maxlength="150" required />
        <span asp-validation-for="Location" class="field-error"></span>
    </div>
    <div class="col-md-2">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" type="number" step="0.01" min="0.01" class="form-control" required />
        <span asp-validation-for="DistanceKm" class="field-error"></span>
    </div>
    <div class="col-12">
        <label asp-for="Banner" class="form-label"></label>
        @if (!string.IsNullOrEmpty(Model.CurrentBannerUrl))
        {
            <div class="mb-2"><img class="banner-preview" src="@Api.ImageUrl(Model.CurrentBannerUrl)" alt="Current banner" /></div>
        }
        <input asp-for="Banner" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
        <div class="form-text">JPG, PNG or WEBP, up to 5 MB. Leave empty to keep the current banner.</div>
        <span asp-validation-for="Banner" class="field-error"></span>
    </div>
</div>
